# ═══════════════════════════════════════════════════════════════════════════════
# CredFlow — Environment Variables
# Copy this to .env.local for local dev and fill in your values.
# In Vercel: add each variable under Settings → Environment Variables.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Supabase (Required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ─── Security (Required in production) ────────────────────────────────────────
# Random string for authenticating watchdog cron requests.
# Generate with: openssl rand -hex 32
#
# Vercel Cron automatically sends this value as `Authorization: Bearer <CRON_SECRET>`.
# Add CRON_SECRET in Vercel → Settings → Environment Variables (Production).
# Verify in Vercel function logs for /api/watchdog that runs return 200.
CRON_SECRET=

# ─── Optional PAID features — all OFF by default (app runs free without them) ─
# Each needs its switch set to 'true' AND its credentials. See lib/features.js.
# FEATURE_AI: Anthropic follow-up emails + OPCA extraction (paid; sends data to a vendor)
FEATURE_AI=false
ANTHROPIC_API_KEY=

# FEATURE_EMAIL_DIGEST: Monday digest + deadline-milestone emails to org owners/admins.
# Resend free plan = 100 emails/day. DIGEST_FROM must be on a domain verified in Resend,
# e.g. "Lacentra <alerts@yourdomain.com>". (Testing only: onboarding@resend.dev can send to your own Resend login email.)
FEATURE_EMAIL_DIGEST=false
RESEND_API_KEY=
DIGEST_FROM=

# ─── App origin / signup ──────────────────────────────────────────────────────
# Exact production origin, e.g. https://app.example.com (no trailing slash)
NEXT_PUBLIC_APP_URL=
# Self-registration UI is hidden unless this is 'true'. Also disable signups in Supabase.
NEXT_PUBLIC_ALLOW_SIGNUP=false
